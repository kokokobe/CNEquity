<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/scheduler/install_scheduler.sh — do not edit the installed copy;
     re-run the installer to regenerate. __PLACEHOLDERS__ are substituted there. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cnequity.events</string>

  <!-- launchd hands an agent the system default of 256 descriptors, and
       compacting a dataset with thousands of day partitions exhausts that:
       `trading_status` failed twice on 2026-09-18 with "Too many open files
       (os error 24)". An interactive shell never sees it, which is why this
       only ever fails on a schedule. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/scheduler/events_pipeline.sh</string>
  </array>

  <!-- Fires every day of the week, weekends and holidays included: that is the
       point of the events job, and `cne run events` does not consult the
       trading calendar. 14:00 is the host's local time, not Beijing time.
       Move it so the sweep runs after that day's disclosures are likely posted.

       Firing more often is a per-feed decision, not a free one: the disclosure
       sweep re-reads a 30-day reconciliation tail every time it runs, while the
       news wire is a single live page. Add a second agent (or a cron line) with
       CNE_EVENTS_GROUP=news_wire if you want intraday headlines. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>14</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CNE_EVENTS_JITTER_SEC</key>
    <string>300</string>
    <key>CNE_SOURCE_VANTAGE</key>
    <string>__SOURCE_VANTAGE__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd-events.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd-events.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
