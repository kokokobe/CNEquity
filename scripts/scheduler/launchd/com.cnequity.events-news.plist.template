<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/scheduler/scheduler_config.py — do not edit the installed copy;
     re-run the installer to regenerate. __PLACEHOLDERS__ are substituted there. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cnequity.events-news</string>

  <!-- launchd hands an agent the system default of 256 descriptors, and
       compacting a dataset with thousands of day partitions exhausts that:
       this job's compact failed twice on 2026-09-18 with "Too many open files
       (os error 24)" on `trading_status`. An interactive shell never sees it,
       which is why this only ever fails on a schedule. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/scheduler/events_pipeline.sh</string>
  </array>

  <!-- The news wire is a single live page, cheap enough to re-read all day,
       which is what separates this agent from `com.cnequity.events`: that one
       runs the whole events group once a day and re-reads a 30-day
       reconciliation tail every time. An installed copy's own interval is
       preserved on regeneration, so an operator who retuned this keeps it. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CNE_EVENTS_GROUP</key>
    <string>news_wire</string>
    <!-- StartInterval fires on an exact period; the wrapper adds a random
         0..N second start offset so the upstream does not see a metronome. -->
    <key>CNE_EVENTS_JITTER_SEC</key>
    <string>120</string>
    <!-- Overnight (Beijing 01:00-06:59) the wire is nearly idle: tick hourly
         instead of every 15 minutes. Each sweep resumes from the newest item
         held, so nothing is skipped. Empty the value to turn this off. -->
    <key>CNE_EVENTS_QUIET_HOURS</key>
    <string>1-7</string>
    <key>CNE_EVENTS_QUIET_GAP_SEC</key>
    <string>3600</string>
    <key>CNE_SOURCE_VANTAGE</key>
    <string>__SOURCE_VANTAGE__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/com.cnequity.events-news.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/com.cnequity.events-news.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
